[Unit]
Description=openforge-maintain Core Service
Documentation=https://github.com/openforge-maintain/openforge-maintain
After=network.target docker.socket
Wants=docker.socket

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/openforge-maintain
ExecStart=/opt/openforge-maintain/bin/core
Restart=always
RestartSec=5
LimitNOFILE=65535

# Environment
Environment=MAINTAIN_PORT=9999
Environment=MAINTAIN_DB_PATH=/opt/openforge-maintain/data/core.db
Environment=MAINTAIN_SECRET=CHANGE_ME_IN_PRODUCTION
Environment=MAINTAIN_SECURITY_ENTRY=default
Environment=GIN_MODE=release

# Security
NoNewPrivileges=false
ProtectSystem=false

[Install]
WantedBy=multi-user.target
